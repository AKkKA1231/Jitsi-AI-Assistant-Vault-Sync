{
  "manifest_version": 3,
  "name": "Meetings_AI Assistant",
  "version": "1.1.0",
  "description": "Free AI meeting notes, continuous Speech-to-Text, and automated Google Drive upload with 1-click multi-account switcher.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "tabCapture"
  ],
  "host_permissions": [
    "https://meet.jit.si/*",
    "https://*.jitsi.net/*",
    "https://*.jitsi.org/*",
    "https://meet.google.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://hooks.slack.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meeting AI Assistant Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.jit.si/*",
        "https://*.jitsi.net/*",
        "https://*.jitsi.org/*",
        "https://meet.google.com/*"
      ],
      "js": [
        "modules/vault.js",
        "modules/audioMixer.js",
        "modules/recorder.js",
        "modules/transcriber.js",
        "modules/ui.js",
        "driveUploader.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
